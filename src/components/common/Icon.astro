---
/** Lucide icon by name for .astro files (React islands import lucide-react directly). */
import * as icons from '@lucide/astro';

interface Props { name: string; size?: number; class?: string }
const { name, size = 20, class: cls } = Astro.props;
const Cmp = (icons as Record<string, any>)[name] ?? icons.Circle;
---
<Cmp size={size} class={cls} stroke-width={1.75} />
