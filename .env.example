# New machine? Do not fill this by hand — run the prompt library: prompts/setup/00-orientation.md
# (Claude Code: type /next). Prompt 01 fills the Supabase keys, 03 the site block, 05 hCaptcha, 06 storage.

# ── Site ────────────────────────────────────────────────────────────────
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_SITE_NAME=Agentic Store
PUBLIC_CURRENCY=USD

# ── Demo / Supabase ─────────────────────────────────────────────────────
# auto (default): demo data when PUBLIC_SUPABASE_ANON_KEY is empty · on / off to force
PUBLIC_DEMO_MODE=auto

# Supabase (local: `supabase start` prints these). Leave the key empty to stay in demo mode.
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ── hCaptcha (https://dashboard.hcaptcha.com) ───────────────────────────
# Also paste the secret into Supabase → Auth → Bot protection (hCaptcha)
PUBLIC_HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=

# ── Media storage: local | hostinger ────────────────────────────────────
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=public/uploads
# Hostinger shared hosting (see deploy/hostinger/uploader.php)
HOSTINGER_UPLOAD_ENDPOINT=https://yourdomain.com/uploader.php
HOSTINGER_UPLOAD_SECRET=
HOSTINGER_BASE_URL=https://yourdomain.com/uploads
