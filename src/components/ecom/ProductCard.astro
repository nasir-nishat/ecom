---
import { ROUTES } from '../../config/constants';
import { formatPrice } from '../../lib/format';
import StarRating from '../common/StarRating.astro';
import AddToCart from './AddToCart';
import type { Product } from '../../types/ecom';

interface Props { product: Product }
const { product: p } = Astro.props;
const href = ROUTES.product(p.slug);
const off = p.compare_at_price && p.compare_at_price > p.price ? Math.round((1 - p.price / p.compare_at_price) * 100) : 0;
---
<article class="card bg-base-100 border border-base-300 group" data-testid="product-card">
  <a href={href} class="relative m-2 aspect-square overflow-hidden rounded-[calc(var(--radius-box)-0.5rem)] bg-base-200">
    {p.images[0] ? (
      <img src={p.images[0]} alt={p.title} loading="lazy" class="size-full object-cover transition-transform duration-300 group-hover:scale-105" />
    ) : (
      <div class="size-full grid place-items-center opacity-40 text-sm">No image</div>
    )}
    {off > 0 && <span class="badge badge-primary badge-sm absolute top-2 left-2 font-semibold">-{off}%</span>}
    {p.stock <= 0 && <span class="badge badge-neutral badge-sm absolute top-2 right-2">Sold out</span>}
  </a>
  <div class="card-body p-3 pt-1 gap-1.5">
    <a href={href} class="text-sm font-medium line-clamp-1" title={p.title}>{p.title}</a>
    <StarRating rating={p.rating} count={p.review_count} />
    <div class="flex items-baseline gap-2">
      <span class="font-semibold">{formatPrice(p.price, p.currency)}</span>
      {off > 0 && <s class="text-xs opacity-50">{formatPrice(p.compare_at_price!, p.currency)}</s>}
    </div>
    <AddToCart client:visible product={p} size="sm" />
  </div>
</article>
